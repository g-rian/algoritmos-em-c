{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build active C file",
      "type": "shell",
      "command": "C:/MinGW/bin/gcc.exe",
      "args": [
        "-g",
        "${file}",
        "-o",
        "${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
